# Copy to .env.local and fill in. .env.local is git-ignored.

# Deployed Google Apps Script /exec endpoint that the Users page "Sync to
# Google Sheets" button posts to. The URL is itself the credential — anyone
# holding it can write to the sheet — so it is not committed.
#
# NOTE: Vite inlines every VITE_* var into the client bundle. This keeps the
# URL out of the repo, not out of the shipped JavaScript. Treat it as
# semi-public until the sync is moved behind the backend.
VITE_SHEETS_SCRIPT_URL=

# Optional. API origin the panel calls. Unset means the deployed API
# (https://api.aarambh.app). Point it at a local server when the panel needs an
# endpoint that has not been deployed yet:
#   VITE_API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=
